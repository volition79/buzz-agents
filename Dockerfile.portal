# syntax=docker/dockerfile:1.7
ARG PYTHON_IMAGE=python:3.12.15-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
FROM docker:28.5.1-cli@sha256:9190b0613792e658a7783cf14b2d5ace5941bb68ede7276922ea36ee457d76ad AS docker-cli
FROM ${PYTHON_IMAGE} AS base
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY LICENSE /usr/local/share/licenses/buzz-agents/LICENSE
COPY buzz_agents /app/buzz_agents
RUN chmod -R a+rX,go-w /app

FROM base AS broker
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN mkdir -p /control /rpc /var/lib/buzz-agents-v2 /var/lib/buzz-agents-easy-scheduler
USER 0:0
CMD ["python", "-m", "buzz_agents.portal_broker"]

FROM base AS portal
COPY connect/assets/Buzz-VPS-Connect.exe /artifacts/Buzz-VPS-Connect.exe
RUN groupadd --gid 10002 portal \
    && useradd --uid 10002 --gid 10002 --no-create-home portal \
    && mkdir /portal && chown 10002:10002 /portal \
    && chmod 0700 /portal && chmod 0444 /artifacts/Buzz-VPS-Connect.exe
USER 10002:10002
EXPOSE 8080
CMD ["python", "-m", "buzz_agents.portal"]
